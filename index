<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <title>我的免费网站</title>
  <style>
    body { text-align: center; margin-top: 50px; }
    img { width: 300px; border-radius: 10px; }
    ul { list-style-type: none; padding: 0; }
    li { margin: 10px 0; }
    a { font-size: 20px; text-decoration: none; }
        /* 第一步：去掉 ul 默认的小圆点和左边空白 */
    .nav {
      list-style: none; /* 去掉小圆点 */
      padding: 0;       /* 去掉左边空白 */
      background: #f5f5f5; /* 背景色 */
      padding: 15px;    /* 内边距 */
    }

    /* 第二步：让 li 横着排列（关键！） */
    .nav li {
      display: inline-block; /* 横向显示 */
      margin: 0 15px;        /* 每个菜单之间的距离 */
    }

    /* 第三步：美化链接 */
    .nav a {
      text-decoration: none; /* 去掉下划线 */
      color: #333;          /* 文字颜色 */
      font-size: 18px;
    }

    /* 鼠标悬停效果 */
    .nav a:hover {
      color: #007bff;
    }
  </style>
</head>
<body>

  <h1>我的第一个免费网站</h1>

  <!-- 点击图片跳转 -->
  <a href="https://www.baidu.com" target="_blank">
    <img src="https://picsum.photos/300/200" alt="点击跳转">
  </a>

 <!-- 横向导航菜单 -->
  <ul class="nav">
    <li><a href="#">首页</a></li>
    <li><a href="#">博客</a></li>
    <li><a href="#">作品</a></li>
    <li><a href="#">关于我</a></li>
    <li><a href="#">联系我</a></li>
  </ul>

</body>
</html>

